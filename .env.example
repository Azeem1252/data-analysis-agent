# LLM Provider Configuration ("groq" or "mistral")
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Model Selection
# Groq models: llama-3.3-70b-versatile, openai/gpt-oss-120b, etc.
# Mistral models: mistral-large-latest, mistral-small-latest
MODEL_NAME=llama-3.3-70b-versatile

# Self-Correction & Execution Limits
MAX_RETRIES=3
SANDBOX_TIMEOUT_SECONDS=15
MAX_UPLOAD_MB=25
SESSION_TTL_MINUTES=60

# Sandbox Security Mode (false = isolated subprocess, true = docker sandbox container)
USE_DOCKER_SANDBOX=false
